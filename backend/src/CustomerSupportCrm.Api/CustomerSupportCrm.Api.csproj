<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <!-- Dev-only API explorer, gated behind app.Environment.IsDevelopment() in Program.cs. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.4" />
    <!-- PasswordHasher<TUser> comes from Microsoft.Extensions.Identity.Core, which is part of the
         ASP.NET Core 10 shared framework — referencing it explicitly here only raises NU1510.
         The class library (Infrastructure) does reference it, because it is not a web project.
         The full Microsoft.AspNetCore.Identity stack (stores, UI, SignInManager) is deliberately
         not referenced anywhere: we need the hasher, nothing else. -->
    <!-- Design-time only. The EF Core tools require this in the *startup* project, not just in the
         project that owns the migrations. PrivateAssets keeps it out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CustomerSupportCrm.Infrastructure\CustomerSupportCrm.Infrastructure.csproj" />
  </ItemGroup>

</Project>
